# Copy to .env.e2e (git-ignored) to run the suite against the hosted API with
# tools/e2e/run.sh hosted <file>. The local target writes its own
# .env.e2e.local with the same keys; never commit either file.
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=
E2E_MANAGER_USERNAME=
E2E_MANAGER_PASSWORD=
E2E_USER_USERNAME=
E2E_USER_PASSWORD=
