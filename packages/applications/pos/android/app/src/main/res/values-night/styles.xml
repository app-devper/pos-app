<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window while the app starts when the OS's dark mode is on: the
         app's dark surface with its mark centred. Flutter removes it when it
         draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- The window colour; Android 12 and later take their splash colour
             from values-v31. -->
        <item name="android:colorBackground">@color/launch_surface</item>
    </style>
</resources>
