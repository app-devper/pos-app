<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen before Android 12: the app's surface (light or dark,
     launch_colors.xml) with the mark on its brand disc centred.
     launch_mark.png is tools/icons/make-icons.sh's, drawn on the same
     surface for each mode (drawable-*dpi and drawable-night-*dpi): the
     mipmap foreground cannot serve here, as it has no transparency. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_surface" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
