<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later in dark mode: their own splash (the launcher
         icon at its centre) on the app's dark surface. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:colorBackground">@color/launch_surface</item>
        <item name="android:windowSplashScreenBackground">@color/launch_surface</item>
    </style>
</resources>
